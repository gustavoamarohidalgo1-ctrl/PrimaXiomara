# Publicar únicamente los archivos de Servitotal indicados aquí.
# Los archivos nuevos requieren inclusión explícita para evitar compartir datos del negocio.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LEEME.txt
!/agencia.py
!/contratos_servitotal.py
!/logo.png
!/icono.png
!/icono.ico
!/icono.icns
!/Iniciar.bat
!/Crear_EXE.bat
!/Crear_App_Mac.command
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/windows-smoke.yml
!/.github/workflows/windows-python.yml
!/.github/workflows/windows-pruebas.yml
!/test_agencia.py
!/test_contratos_servitotal.py
!/test_migracion_servitotal.py
!/test_fiabilidad_documentos_respaldos.py
!/test_fiabilidad_estados.py
!/test_fiabilidad_exportacion.py
!/test_fiabilidad_finanzas.py
!/test_fiabilidad_helpers.py
!/test_optimizacion.py
!/test_optimizacion_ui.py
!/test_instaladores_fiabilidad.py
!/test_datos_version_anterior.py
!/test_arranque_windows.py
!/instaladores/
/instaladores/*
!/instaladores/Servitotal-Windows-x64.exe
!/instaladores/Servitotal-Mac-arm64.dmg
!/instaladores/Servitotal-1.7.1-Windows-portable.zip
!/instaladores/Servitotal-1.7.1-Windows-Python.zip
!/instaladores/SHA256SUMS.txt
!/instaladores/construccion/
/instaladores/construccion/*
!/instaladores/construccion/crear_instalador_windows.sh
!/instaladores/construccion/crear_instalador_mac.sh
!/instaladores/construccion/crear_iconos.sh
!/instaladores/construccion/archivos_en_uso.nsh
!/instaladores/construccion/instalador.nsi
!/instaladores/construccion/minimo_macos.py
!/instaladores/construccion/iniciar.pyw
!/instaladores/construccion/version_windows.txt
!/instaladores/construccion/verificar_windows.py
!/instaladores/construccion/verificar_portable_windows.py
!/instaladores/construccion/crear_portable_windows.py
!/instaladores/construccion/abrir_portable.pyw
!/instaladores/construccion/abrir_python.pyw
!/instaladores/construccion/crear_paquete_python.py
!/instaladores/construccion/verificar_python_windows.py

# Exclusiones explícitas: datos privados y archivos generados.
analisis/
verificacion/
respaldo_*/
respaldos/
contratos/
tmp/
output/
__pycache__/
*.py[cod]
*.db
*.db-*
*.sqlite
*.sqlite3
*.log
*.app/
*.pdf
*.csv
*.xlsx
configuracion.json
borradores.json
.DS_Store
.env
.env.*
*.pem
*.key
